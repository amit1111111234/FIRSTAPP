<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="24dp"
    tools:context=".ActivityAddPoint">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Point on Map"
        android:textColor="#B19CD9"
        android:textSize="28sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/btnAddPointToMap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etPointName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Name of the Point"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#B19CD9"
                android:inputType="text" />

            <EditText
                android:id="@+id/etSoldierName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:hint="Name of Soldier"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#B19CD9"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Description"
                android:minLines="3"
                android:gravity="top"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#B19CD9"
                android:inputType="textMultiLine" />

            <EditText
                android:id="@+id/etCoordinates"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:hint="Coordinates (Lat, Long)"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#B19CD9"
                android:inputType="text" />

            <EditText
                android:id="@+id/etLocationName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:hint="Location Name"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#B19CD9"
                android:inputType="text" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddPointToMap"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="ADD POINT TO MAP"
        app:cornerRadius="16dp"
        app:backgroundTint="#9279E6"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>