<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3A3A36"
    android:padding="16dp"
    tools:context=".ActivityAddPoint">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#BCCFC2" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Point"
        android:textColor="#BCCFC2"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        android:layout_marginStart="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/btnAddPointToMap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etPointName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Name of the Point"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#BCCFC2"
                android:inputType="text" />

            <EditText
                android:id="@+id/etSoldierName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:hint="Name of Soldier"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#BCCFC2"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Description"
                android:minLines="3"
                android:gravity="top"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#BCCFC2"
                android:inputType="textMultiLine" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp">
                <fragment
                    android:id="@+id/mapPicker"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:translationY="-22dp"
                    app:tint="#FF4444" />
            </FrameLayout>

            <EditText
                android:id="@+id/etLocationName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:hint="Location Address"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8EAA"
                android:backgroundTint="#BCCFC2"
                android:inputType="text" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddPointToMap"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="ADD POINT TO MAP"
        app:cornerRadius="16dp"
        app:backgroundTint="#6F8367"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>